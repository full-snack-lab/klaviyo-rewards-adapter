{
  "name": "@fullsnacklab/klaviyo-rewards-adapter",
  "version": "0.2.0",
  "description": "Typed Klaviyo OAuth client with token storage and Infisical secrets",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "bunup",
    "dev": "bunup --watch",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "check": "bun run --sequential type-check test",
    "format": "oxfmt src/*.ts bunup.config.ts package.json",
    "format:check": "bun run format -- --check",
    "lint": "oxlint src/*.ts bunup.config.ts"
  },
  "dependencies": {
    "@infisical/sdk": "^5.0.2",
    "klaviyo-api": "^23.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^24.0.0",
    "bunup": "^0.16.32",
    "msw": "^2.15.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "typescript": "^6",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
